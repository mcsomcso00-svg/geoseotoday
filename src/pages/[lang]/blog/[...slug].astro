---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { AUTHOR } from '../../../consts';

export async function getStaticPaths() {
  const now = new Date();
  // 日期閘門：發布日 <= 今天才建置頁面 → 配合每日 cron 自動滴灌上線
  const posts = await getCollection('blog', (p) => !p.data.draft && p.data.date_published <= now);
  return posts.map((post) => {
    const [lang, ...rest] = post.id.split('/');
    return { params: { lang, slug: rest.join('/') }, props: { post } };
  });
}
const { post } = Astro.props;
const lang = Astro.params.lang as 'zh-hant' | 'zh-hans' | 'en';
const { Content } = await render(post);
const fmt = (d: Date) => d.toISOString().slice(0, 10);
const authorPath = `/${lang}/about/`;

// hreflang：本文 + frontmatter.translations 指到的其他語言版本
const slug = post.id.split('/').slice(1).join('/');
const selfPath = `/${lang}/blog/${slug}/`;
const ogPath = `/og-image/${lang}--${slug}.png`;
const alternates: Record<string, string> = { [lang]: selfPath };
if (post.data.translations) {
  for (const [l, slug] of Object.entries(post.data.translations)) {
    alternates[l] = `/${l}/blog/${slug}/`;
  }
}

// Article schema
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  author: {
    '@type': 'Person',
    name: AUTHOR.name,
    alternateName: AUTHOR.displayName,
    url: new URL(authorPath, Astro.site).toString(),
    worksFor: { '@type': 'Organization', name: 'GeoSeoToday', url: Astro.site?.toString() },
    ...(AUTHOR.sameAs.length ? { sameAs: AUTHOR.sameAs } : {}),
  },
  publisher: { '@type': 'Organization', name: 'GeoSeoToday' },
  image: { '@type': 'ImageObject', url: new URL(ogPath, Astro.site).toString(), width: 1200, height: 630 },
  datePublished: post.data.date_published.toISOString(),
  dateModified: (post.data.date_updated ?? post.data.date_published).toISOString(),
  inLanguage: lang === 'en' ? 'en' : lang === 'zh-hans' ? 'zh-Hans' : 'zh-Hant',
  mainEntityOfPage: new URL(selfPath, Astro.site).toString(),
};

// 從內文「**Q1：...**\n答案段」自動抽 FAQPage schema（產線模板固定此格式）
const faqPairs: { q: string; a: string }[] = [];
const faqRe = /\*\*Q\d+[：:]\s*([^*]+?)\*\*\s*\n([^\n*][^\n]*(?:\n(?![*\n#])[^\n]+)*)/g;
let m;
while ((m = faqRe.exec(post.body ?? '')) !== null) {
  faqPairs.push({ q: m[1].trim(), a: m[2].trim().replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') });
}
const faqSchema =
  faqPairs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqPairs.map((f) => ({
          '@type': 'Question',
          name: f.q,
          acceptedAnswer: { '@type': 'Answer', text: f.a },
        })),
      }
    : null;

const schemas = faqSchema ? [articleSchema, faqSchema] : [articleSchema];

const BC = {
  'zh-hant': { home: '首頁', blog: '部落格' },
  'zh-hans': { home: '首页', blog: '博客' },
  en: { home: 'Home', blog: 'Blog' },
}[lang];

// 相關文章：同群集、日期已上線、排除自己
// - enhanced 文章：取群集內（依日期排序、頭尾相接）前後各 3 篇，共 6 篇 → 每篇都分到入站連結，不再集中在最新幾篇
// - 其他文章：維持原本「最新 3 篇」
const now = new Date();
const clusterPosts = (
  await getCollection(
    'blog',
    (p) =>
      p.id.startsWith(`${lang}/`) &&
      !p.data.draft &&
      p.data.date_published <= now &&
      p.data.cluster === post.data.cluster
  )
).sort((a, b) => a.data.date_published.valueOf() - b.data.date_published.valueOf() || a.id.localeCompare(b.id));
let related: typeof clusterPosts;
if (post.data.enhanced) {
  const i = clusterPosts.findIndex((p) => p.id === post.id);
  const n = clusterPosts.length;
  const picks = new Map<string, (typeof clusterPosts)[number]>();
  for (let d = 1; d < n && picks.size < 6; d++) {
    for (const j of [i - d, i + d]) {
      const p = clusterPosts[((j % n) + n) % n];
      if (p.id !== post.id && picks.size < 6) picks.set(p.id, p);
    }
  }
  related = [...picks.values()];
} else {
  related = clusterPosts
    .filter((p) => p.id !== post.id)
    .reverse()
    .slice(0, 3);
}

// 文末轉換卡文案
const CTA = {
  'zh-hant': {
    title: '想知道你的網站離「被 AI 引用」還有多遠？',
    desc: '30 秒免費檢測你的文章，或領取一份指名到頁面與段落的完整網站診斷報告。',
    primary: '免費領取診斷報告',
    secondary: '先用免費檢測器試試',
    related: '延伸閱讀',
    updated: '更新',
    by: '作者',
  },
  'zh-hans': {
    title: '想知道你的网站离「被 AI 引用」还有多远？',
    desc: '30 秒免费检测你的文章，或领取一份指名到页面与段落的完整网站诊断报告。',
    primary: '免费领取诊断报告',
    secondary: '先用免费检测器试试',
    related: '延伸阅读',
    updated: '更新',
    by: '作者',
  },
  en: {
    title: 'How far is your site from being cited by AI?',
    desc: 'Check any article free in 30 seconds, or get a full site diagnosis report pinned to exact pages and paragraphs.',
    primary: 'Get my free audit report',
    secondary: 'Try the free checker first',
    related: 'Related articles',
    updated: 'Updated',
    by: 'By',
  },
}[lang];
const breadcrumbs = [
  { name: BC.home, url: `/${lang}/` },
  { name: BC.blog, url: `/${lang}/blog/` },
  { name: post.data.title, url: selfPath },
];
---
<Base
  title={post.data.title}
  description={post.data.description ?? ''}
  lang={lang}
  alternates={alternates}
  schemas={schemas}
  breadcrumbs={breadcrumbs}
  ogImage={ogPath}
>
  <article>
    <img class="post-cover" src={ogPath} alt="" width="1200" height="630" loading="eager" fetchpriority="high" />
    <p class="post-meta">
      {CTA.by} <a href={authorPath} rel="author">{AUTHOR.displayName}</a> · {fmt(post.data.date_published)}
      {post.data.date_updated && post.data.date_updated > post.data.date_published && ` · ${CTA.updated} ${fmt(post.data.date_updated)}`}
      {post.data.cluster && ` · ${post.data.cluster}`}
    </p>
    <Content />
  </article>

  <aside class="post-cta">
    <p class="post-cta-title">{CTA.title}</p>
    <p class="post-cta-desc">{CTA.desc}</p>
    <div class="post-cta-btns">
      <a class="post-cta-btn" href={`/${lang}/audit/`} data-ga="article_audit">{CTA.primary}</a>
      <a class="post-cta-link" href={`/${lang}/geo/`} data-ga="article_geo_checker">{CTA.secondary} →</a>
    </div>
  </aside>

  {related.length > 0 && (
    <section class="related">
      <h2>{CTA.related}</h2>
      <ul class="card-list">
        {related.map((p) => (
          <li>
            <a href={`/${lang}/blog/${p.id.split('/').slice(1).join('/')}/`}>{p.data.title}</a>
            <p>{p.data.description}</p>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .post-cover {
    display: block; width: 100%; height: auto; aspect-ratio: 1200 / 630;
    object-fit: cover; border: 1px solid var(--line); border-radius: 14px;
    margin: 0 0 24px;
  }
  .post-cta {
    margin-top: 40px; padding: 24px 26px; border-radius: 14px;
    background: linear-gradient(135deg, #1a2740, #171b22);
    border: 1px solid #2f4a7a;
  }
  .post-cta-title { font-size: 18px; font-weight: 800; margin: 0 0 6px; }
  .post-cta-desc { color: var(--dim); font-size: 14px; margin: 0 0 16px; }
  .post-cta-btns { display: flex; gap: 16px; align-items: center; flex-wrap: wrap; }
  .post-cta-btn {
    background: var(--cta); color: var(--cta-ink) !important; text-decoration: none;
    font-weight: 700; font-size: 15px; padding: 12px 22px; border-radius: 10px;
    box-shadow: var(--cta-glow); transition: filter .2s;
  }
  .post-cta-btn:hover { filter: brightness(1.08); }
  .post-cta-link { font-size: 14px; }
  .related h2 { margin-top: 36px; }
</style>
